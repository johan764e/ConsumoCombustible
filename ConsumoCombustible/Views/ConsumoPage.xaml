<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConsumoCombustible.Views.ConsumoPage">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry Placeholder="Kilómetros" Text="{Binding Km}" />
        <Entry Placeholder="Litros" Text="{Binding Litros}" />
        <Button Text="Calcular rendimiento" Command="{Binding CalcularCommand}" />
        <Label Text="{Binding Mensaje}" TextColor="Red" />
        <Label Text="{Binding Rendimiento}" />
        <Label Text="{Binding Nivel}" />
    </VerticalStackLayout>
</ContentPage>